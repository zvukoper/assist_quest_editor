<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AssistQuestEditor</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>1.0.40.174</Version>
    <AssemblyVersion>1.0.40.174</AssemblyVersion>
    <FileVersion>1.0.40.174</FileVersion>
    <AssemblyInformationalVersion>1.0.40.174-GAPS-R22</AssemblyInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssistQuestRepositoryRoot Condition="'$(AssistQuestRepositoryRoot)' == ''"></AssistQuestRepositoryRoot>
    <AssistQuestRepositoryUrl Condition="'$(AssistQuestRepositoryUrl)' == ''"></AssistQuestRepositoryUrl>
    <AssistQuestRepositoryBranch Condition="'$(AssistQuestRepositoryBranch)' == ''">unknown</AssistQuestRepositoryBranch>
    <AssistQuestRepositoryCommit Condition="'$(AssistQuestRepositoryCommit)' == ''">unknown</AssistQuestRepositoryCommit>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AssistQuestRepositoryRoot" Value="$(AssistQuestRepositoryRoot)" />
    <AssemblyMetadata Include="AssistQuestRepositoryUrl" Value="$(AssistQuestRepositoryUrl)" />
    <AssemblyMetadata Include="AssistQuestRepositoryBranch" Value="$(AssistQuestRepositoryBranch)" />
    <AssemblyMetadata Include="AssistQuestRepositoryCommit" Value="$(AssistQuestRepositoryCommit)" />
    <ProjectReference Include="../AssistQuestEditor.Domain/AssistQuestEditor.Domain.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <None Update="Assets/SplashScreen.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Web/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/world/sdo_points.json" Link="data/world/sdo_points.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/world/cities.json" Link="data/world/cities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/quests/*.aqquest" LinkBase="data/quests">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/campaigns/**/*" LinkBase="data/campaigns">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/scenes/*.aqscene" LinkBase="data/scenes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- Портреты НПЦ: UI репутации ссылается на них относительным путём
         data/images/..., поэтому они должны попадать в output и publish. -->
    <None Include="../../data/images/*.png" LinkBase="data/images">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="VerifyDataResources" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!--
      Ресурсы data копируются в каталог сборки отдельной задачей, а не через
      CopyToOutputDirectory: так они лежат рядом с исполняемым файлом и читаются
      приложением напрямую, а не из временного кэша распаковки single-file.
      Синхронизация идёт по манифесту с SHA-256, поэтому остаток прошлой сборки
      или файл со старой схемой не сможет проехать незамеченным.
    -->
    <PropertyGroup>
      <AssistQuestSyncScript>$(MSBuildThisFileDirectory)../../ci/sync_data_resources.ps1</AssistQuestSyncScript>
      <AssistQuestResourceTarget>$(TargetDir)data</AssistQuestResourceTarget>
    </PropertyGroup>

    <!--
      Проверка запускается через apphost рядом с DLL, а не через $(TargetPath):
      $(TargetPath) указывает на DLL, и Windows открыла бы его как документ,
      а не выполнила. Приложение собрано как WinExe, поэтому вердикт читается
      из файла отчёта, который оно пишет рядом с собой.
    -->
    <PropertyGroup>
      <AssistQuestVerifyHost>$(TargetDir)$(AssemblyName).exe</AssistQuestVerifyHost>
      <AssistQuestResourceReport>$(TargetDir)data-verify-report.txt</AssistQuestResourceReport>
    </PropertyGroup>

    <Error Condition="!Exists('$(AssistQuestSyncScript)')"
           Text="Скрипт синхронизации ресурсов не найден: $(AssistQuestSyncScript)" />

    <Error Condition="!Exists('$(AssistQuestVerifyHost)')"
           Text="Исполняемый файл приложения не найден для проверки ресурсов: $(AssistQuestVerifyHost)" />

    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(AssistQuestSyncScript)&quot; -SourceDirectory &quot;$(MSBuildThisFileDirectory)../../data&quot; -TargetDirectory &quot;$(AssistQuestResourceTarget)&quot; -AppVersion &quot;$(Version)&quot; -Commit &quot;$(AssistQuestRepositoryCommit)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.." />

    <Delete Files="$(AssistQuestResourceReport)" ContinueOnError="true" />

    <Exec Command="&quot;$(AssistQuestVerifyHost)&quot; --verify-resources"
          WorkingDirectory="$(TargetDir)"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="AssistQuestResourceExitCode" />
    </Exec>

    <!-- ReadLinesFromFile — штатная задача MSBuild: функции вида
         [System.IO.File]::ReadAllLines запрещены в property functions. -->
    <ReadLinesFromFile File="$(AssistQuestResourceReport)"
                       Condition="Exists('$(AssistQuestResourceReport)')">
      <Output TaskParameter="Lines" ItemName="AssistQuestResourceReportLines" />
    </ReadLinesFromFile>

    <Message Condition="Exists('$(AssistQuestResourceReport)')"
             Importance="high"
             Text="Ресурсы публикации: @(AssistQuestResourceReportLines, ' | ')" />

    <Error Condition="'$(AssistQuestResourceExitCode)' != '0'"
           Text="Проверка целостности ресурсов публикации не пройдена (код $(AssistQuestResourceExitCode)). Отчёт: $(AssistQuestResourceReport)" />
  </Target>

  <Target Name="SyncDataResourcesToPublish" AfterTargets="Publish">
    <!--
      Ресурсы попадают в публикацию настоящей папкой data рядом с EXE, а не только
      внутрь single-file. Причина: включённый в single-file ресурс распаковывается
      в системный кэш, который не виден и не заменяется, а папку рядом с EXE
      видит человек, и отдельный файл можно заменить без пересборки. Манифест в
      той же папке фиксирует размер и SHA-256 каждого файла, поэтому остаток
      прошлой сборки или файл со старой схемой не проедет незамеченным.
    -->
    <PropertyGroup>
      <AssistQuestPublishDataDir>$(PublishDir)data</AssistQuestPublishDataDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(AssistQuestSyncScript)')"
           Text="Скрипт синхронизации ресурсов не найден: $(AssistQuestSyncScript)" />

    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(AssistQuestSyncScript)&quot; -SourceDirectory &quot;$(MSBuildThisFileDirectory)../../data&quot; -TargetDirectory &quot;$(AssistQuestPublishDataDir)&quot; -AppVersion &quot;$(Version)&quot; -Commit &quot;$(AssistQuestRepositoryCommit)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.." />

    <!-- Проверка выполняется по опубликованной раскладке: именно её увидит пользователь. -->
    <Delete Files="$(AssistQuestPublishDataDir)/../data-verify-report.txt" ContinueOnError="true" />

    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; --verify-resources"
          WorkingDirectory="$(PublishDir)"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="AssistQuestResourceExitCode" />
    </Exec>

    <ReadLinesFromFile File="$(PublishDir)data-verify-report.txt"
                       Condition="Exists('$(PublishDir)data-verify-report.txt')">
      <Output TaskParameter="Lines" ItemName="AssistQuestPublishedReportLines" />
    </ReadLinesFromFile>

    <Message Condition="Exists('$(PublishDir)data-verify-report.txt')"
             Importance="high"
             Text="Ресурсы публикации: @(AssistQuestPublishedReportLines, ' | ')" />

    <Error Condition="'$(AssistQuestResourceExitCode)' != '0'"
           Text="Проверка целостности ресурсов публикации не пройдена (код $(AssistQuestResourceExitCode)). Отчёт: $(PublishDir)data-verify-report.txt" />
  </Target>

</Project>
