<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AssistQuestEditor</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>1.0.40.121</Version>
    <AssemblyVersion>1.0.40.121</AssemblyVersion>
    <FileVersion>1.0.40.121</FileVersion>
    <AssemblyInformationalVersion>1.0.40.121-QUEST-WINDOW-LAYOUT-R1</AssemblyInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssistQuestRepositoryRoot Condition="'$(AssistQuestRepositoryRoot)' == ''"></AssistQuestRepositoryRoot>
    <AssistQuestRepositoryUrl Condition="'$(AssistQuestRepositoryUrl)' == ''"></AssistQuestRepositoryUrl>
    <AssistQuestRepositoryBranch Condition="'$(AssistQuestRepositoryBranch)' == ''">unknown</AssistQuestRepositoryBranch>
    <AssistQuestRepositoryCommit Condition="'$(AssistQuestRepositoryCommit)' == ''">unknown</AssistQuestRepositoryCommit>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AssistQuestRepositoryRoot" Value="$(AssistQuestRepositoryRoot)" />
    <AssemblyMetadata Include="AssistQuestRepositoryUrl" Value="$(AssistQuestRepositoryUrl)" />
    <AssemblyMetadata Include="AssistQuestRepositoryBranch" Value="$(AssistQuestRepositoryBranch)" />
    <AssemblyMetadata Include="AssistQuestRepositoryCommit" Value="$(AssistQuestRepositoryCommit)" />
    <ProjectReference Include="../AssistQuestEditor.Domain/AssistQuestEditor.Domain.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <None Update="Web/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../data/world/sdo_points.json" Link="data/world/sdo_points.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
