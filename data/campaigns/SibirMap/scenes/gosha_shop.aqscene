          "y": 180,
          "sockets": [
            {
              "socketId": "start.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {}
        },
        {
          "nodeId": "dialogue",
