{
  "schemaVersion": 1,
  "format": "aqquest",
  "definition": {
    "id": "ruslan_shashlik_delivery",
    "title": "Доставка шашлыка",
    "description": "Независимый одноразовый квест: при репутации Гоши от 400 игрок добровольно берёт у Руслана заказ и доставляет шашлык Гоше.",
    "graph": {
      "id": "ruslan_shashlik_delivery",
      "name": "Доставка шашлыка",
      "nodes": [
        {
          "nodeId": "start",
          "nodeType": "Start",
          "title": "01. Начало",
          "x": 0,
          "y": 120,
          "parameters": {},
          "sockets": [
            {
              "socketId": "start.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ]
        },
        {
          "nodeId": "status-active",
          "nodeType": "SetStatus",
          "title": "02. Статус: Active",
          "x": 400,
          "y": 120,
          "parameters": {
            "status": "Active"
          },
          "sockets": [
            {
              "socketId": "status-active.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "status-active.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ]
        },
        {
          "nodeId": "activation-reputation",
          "nodeType": "ReputationCompare",
          "title": "03. Репутация Гоши ≥ 400",
          "x": 800,
          "y": 120,
          "parameters": {
            "operator": "ReputationCompare",
            "npcId": "gosha",
            "comparison": ">=",
            "right": "400"
          },
          "sockets": [
            {
              "socketId": "activation-reputation.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "activation-reputation.true",
              "name": "Да",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "activation-reputation.false",
              "name": "Нет",
              "direction": "Output",
              "flowKind": "Cut"
            }
          ]
        },
        {
          "nodeId": "step-delivery",
          "nodeType": "SetStep",
          "title": "27. Этап: заказ Руслана на доставку",
          "x": 1200,
          "y": 120,
          "sockets": [
            {
              "socketId": "step-delivery.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "step-delivery.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "step": "ruslan_delivery"
          }
        },
        {
          "nodeId": "condition-delivery-available",
          "nodeType": "ReputationCompare",
          "title": "28. У Гоши репутация от 400?",
          "x": 1600,
          "y": 60,
          "sockets": [
            {
              "socketId": "condition-delivery-available.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "condition-delivery-available.true",
              "name": "Да",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "condition-delivery-available.false",
              "name": "Нет",
              "direction": "Output",
              "flowKind": "Cut"
            }
          ],
          "parameters": {
            "operator": "ReputationCompare",
            "npcId": "gosha",
            "comparison": ">=",
            "right": "400"
          }
        },
        {
          "nodeId": "interaction-ruslan-delivery",
          "nodeType": "Interaction",
          "title": "29. Вернуться к Руслану за заказом",
          "x": 2000,
          "y": 120,
          "sockets": [
            {
              "socketId": "interaction-ruslan-delivery.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "interaction-ruslan-delivery.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "worldPointId": "city:ekat",
            "triggerRadius": "1500"
          }
        },
        {
          "nodeId": "scene-ruslan-delivery",
          "nodeType": "DialogueScene",
          "title": "30. Scene: Руслан даёт заказ",
          "x": 2400,
          "y": 120,
          "sockets": [
            {
              "socketId": "scene-ruslan-delivery.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
