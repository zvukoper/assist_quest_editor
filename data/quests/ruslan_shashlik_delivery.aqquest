            {
              "socketId": "condition-delivery-accepted.true",
              "name": "Да",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "condition-delivery-accepted.false",
              "name": "Нет",
              "direction": "Output",
              "flowKind": "Cut"
            }
