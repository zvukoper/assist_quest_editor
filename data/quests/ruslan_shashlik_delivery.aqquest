          "nodeType": "Condition",
          "title": "34. Шашлык передан?",
          "x": 4000,
          "y": 60,
          "sockets": [
            {
              "socketId": "condition-delivery-given.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "condition-delivery-given.true",
              "name": "Да",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "condition-delivery-given.false",
              "name": "Нет",
              "direction": "Output",
              "flowKind": "Cut"
