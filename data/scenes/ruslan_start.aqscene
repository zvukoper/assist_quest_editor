{"schemaVersion":1,"definition":{"id":"ruslan_start","title":"\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u0420\u0443\u0441\u043B\u0430\u043D\u043E\u043C","description":"\u041F\u0435\u0440\u0432\u0430\u044F \u0441\u0446\u0435\u043D\u0430: \u043E\u0431\u044B\u0447\u043D\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430 \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0430 \u043E\u0442 Choice resource.","graph":{"id":"ruslan_start","name":"\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u0420\u0443\u0441\u043B\u0430\u043D\u043E\u043C","nodes":[{"nodeId":"start","nodeType":"SceneStart","title":"\u041D\u0430\u0447\u0430\u043B\u043E \u0441\u0446\u0435\u043D\u044B","x":80,"y":180,"sockets":[{"socketId":"start.out","name":"\u0414\u0430\u043B\u0435\u0435","direction":"Output","flowKind":"Normal"}],"parameters":{}},{"nodeId":"dialogue","nodeType":"Dialogue","title":"\u0420\u0443\u0441\u043B\u0430\u043D: \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435","x":340,"y":180,"sockets":[{"socketId":"dialogue.in","name":"\u0412\u0445\u043E\u0434","direction":"Input","flowKind":"Normal"},{"socketId":"dialogue.out","name":"\u0414\u0430\u043B\u0435\u0435","direction":"Output","flowKind":"Normal"}],"parameters":{"dialogueId":"ruslan.greeting"}},{"nodeId":"choice","nodeType":"Choice","title":"\u0420\u0443\u0441\u043B\u0430\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0443","x":640,"y":180,"sockets":[{"socketId":"choice.in","name":"\u0412\u0445\u043E\u0434","direction":"Input","flowKind":"Normal"},{"socketId":"choice.accept","name":"\u041F\u0440\u0438\u043D\u044F\u0442\u044C","direction":"Output","flowKind":"Normal"},{"socketId":"choice.decline","name":"\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F","direction":"Output","flowKind":"Normal"}],"parameters":{"choiceId":"ruslan.offer"}},{"nodeId":"accept","nodeType":"SceneEnd","title":"\u0421\u0446\u0435\u043D\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430: \u043F\u0440\u0438\u043D\u044F\u0442\u043E","x":960,"y":120,"sockets":[{"socketId":"accept.in","name":"\u0412\u0445\u043E\u0434","direction":"Input","flowKind":"Normal"}],"parameters":{}},{"nodeId":"decline","nodeType":"SceneEnd","title":"\u0421\u0446\u0435\u043D\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430: \u043E\u0442\u043A\u0430\u0437","x":960,"y":250,"sockets":[{"socketId":"decline.in","name":"\u0412\u0445\u043E\u0434","direction":"Input","flowKind":"Normal"}],"parameters":{}}],"connections":[{"fromNodeId":"start","fromSocketId":"start.out","toNodeId":"dialogue","toSocketId":"dialogue.in"},{"fromNodeId":"dialogue","fromSocketId":"dialogue.out","toNodeId":"choice","toSocketId":"choice.in"},{"fromNodeId":"choice","fromSocketId":"choice.accept","toNodeId":"accept","toSocketId":"accept.in"},{"fromNodeId":"choice","fromSocketId":"choice.decline","toNodeId":"decline","toSocketId":"decline.in"}]},"dialogues":[{"id":"ruslan.greeting","speaker":"\u0420\u0443\u0441\u043B\u0430\u043D 2","text":"\u0415\u0441\u0442\u044C \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043E\u0441\u043E\u0431\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435. \u0422\u0435\u0441\u0442."}],"choices":[{"id":"ruslan.offer","title":"\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435","speaker":"\u0420\u0443\u0441\u043B\u0430\u043D","text":"\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043E\u0441\u043E\u0431\u043E\u0435 \u043C\u044F\u0441\u043E \u0434\u043B\u044F \u043C\u043E\u0435\u0433\u043E \u0448\u0430\u0448\u043B\u044B\u0447\u043D\u043E\u0433\u043E \u043C\u0430\u0440\u0438\u043D\u0430\u0434\u0430. \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F?","options":[{"id":"ruslan.offer.accept","text":"\u0414\u0430, \u0431\u0435\u0440\u0443\u0441\u044C.","outputSocketId":"choice.accept"},{"id":"ruslan.offer.decline","text":"\u041D\u0435\u0442, \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u043C\u043E\u0433\u0443.","outputSocketId":"choice.decline"}]}]},"format":"aqscene"}