          "title": "Начало сцены",
          "x": 80,
          "y": 180,
          "sockets": [
            {
              "socketId": "start.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {}
        },
        {
          "nodeId": "dialogue",
          "nodeType": "Dialogue",
          "title": "Гоша принимает шашлык",
          "x": 340,
          "y": 180,
          "sockets": [
            {
              "socketId": "dialogue.in",
              "name": "Вход",
