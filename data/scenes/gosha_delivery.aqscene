    "dialogues": [
      {
        "id": "gosha.delivery.greeting",
        "speaker": "Гоша",
        "text": "О, шашлык от Руслана! Вот это по-нашему. Давай сюда."
      }
    ],
    "choices": [
      {
        "id": "gosha.delivery",
        "title": "Шашлык для Гоши",
        "speaker": "Гоша",
        "text": "Отдашь шашлык?",
        "options": [
          {
            "id": "gosha.delivery.give",
            "text": "Держи, от Руслана.",
