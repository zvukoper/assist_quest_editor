              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "dialogueId": "gosha.delivery.greeting"
          }
        },
        {
          "nodeId": "choice",
          "nodeType": "Choice",
          "title": "Передать шашлык",
          "x": 640,
          "y": 180,
          "sockets": [
            {
              "socketId": "choice.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "choice.give",
              "name": "Передать",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "choice.hold",
              "name": "Придержать",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "choiceId": "gosha.delivery"
          }
        },
        {
          "nodeId": "give",
          "nodeType": "SceneEnd",
          "title": "Сцена завершена: шашлык передан",
          "x": 960,
          "y": 120,
          "sockets": [
            {
              "socketId": "give.in",
              "name": "Вход",
