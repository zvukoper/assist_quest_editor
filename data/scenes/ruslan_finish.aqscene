{
  "schemaVersion": 1,
  "format": "aqscene",
  "definition": {
    "id": "ruslan_finish",
    "title": "Возвращение к Руслану",
    "description": "Финальная сцена: после подтверждения мясо списывается и начисляется репутация.",
    "graph": {
      "id": "ruslan_finish",
      "name": "Возвращение к Руслану",
      "nodes": [
        {
          "nodeId": "start",
          "nodeType": "SceneStart",
          "title": "Начало сцены",
          "x": 80,
          "y": 180,
          "sockets": [
            {
              "socketId": "start.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {}
        },
        {
          "nodeId": "dialogue",
          "nodeType": "Dialogue",
          "title": "Руслан принимает мясо",
          "x": 340,
          "y": 180,
          "sockets": [
            {
              "socketId": "dialogue.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "dialogue.out",
              "name": "Далее",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "dialogueId": "ruslan.finish"
          }
        },
        {
          "nodeId": "choice",
          "nodeType": "Choice",
          "title": "Финальное подтверждение",
          "x": 640,
          "y": 180,
          "sockets": [
            {
              "socketId": "choice.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            },
            {
              "socketId": "choice.complete",
              "name": "Завершить",
              "direction": "Output",
              "flowKind": "Normal"
            },
            {
              "socketId": "choice.cancel",
              "name": "Отменить",
              "direction": "Output",
              "flowKind": "Normal"
            }
          ],
          "parameters": {
            "choiceId": "ruslan.finish"
          }
        },
        {
          "nodeId": "complete",
          "nodeType": "SceneEnd",
          "title": "Сцена завершена: завершение",
          "x": 960,
          "y": 120,
          "sockets": [
            {
              "socketId": "complete.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            }
          ],
          "parameters": {}
        },
        {
          "nodeId": "cancel",
          "nodeType": "SceneEnd",
          "title": "Сцена завершена: отмена",
          "x": 960,
          "y": 250,
          "sockets": [
            {
              "socketId": "cancel.in",
              "name": "Вход",
              "direction": "Input",
              "flowKind": "Normal"
            }
          ],
          "parameters": {}
        }
      ],
      "connections": [
        {
          "fromNodeId": "start",
          "fromSocketId": "start.out",
          "toNodeId": "dialogue",
          "toSocketId": "dialogue.in"
        },
        {
          "fromNodeId": "dialogue",
          "fromSocketId": "dialogue.out",
          "toNodeId": "choice",
          "toSocketId": "choice.in"
        },
        {
          "fromNodeId": "choice",
          "fromSocketId": "choice.complete",
          "toNodeId": "complete",
          "toSocketId": "complete.in"
        },
        {
          "fromNodeId": "choice",
          "fromSocketId": "choice.cancel",
          "toNodeId": "cancel",
          "toSocketId": "cancel.in"
        }
      ]
    },
    "dialogues": [
      {
        "id": "ruslan.finish",
        "speaker": "Руслан",
        "text": "Отлично. Давай закончим наше дело."
      }
    ],
    "choices": [
      {
        "id": "ruslan.finish",
        "title": "Закончить",
        "speaker": "Руслан",
        "text": "Всё готово. Заканчиваем?",
        "options": [
          {
            "id": "ruslan.finish.complete",
            "text": "Да, заканчиваем.",
            "outputSocketId": "choice.complete"
          },
          {
            "id": "ruslan.finish.cancel",
            "text": "Нет, пока остановимся.",
            "outputSocketId": "choice.cancel"
          }
        ]
      }
    ]
